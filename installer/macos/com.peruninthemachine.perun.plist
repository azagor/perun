<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peruninthemachine.perun</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/perun/.venv/bin/python</string>
        <string>-m</string>
        <string>perun</string>
        <string>serve</string>
        <string>--bridge</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/perun</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/perun.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/perun.log</string>
</dict>
</plist>
