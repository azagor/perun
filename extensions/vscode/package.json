{
  "name": "perun-overseer",
  "displayName": "Perun Overseer",
  "description": "Perun workspace link, live agent edit following and OpenCode selection hand-off",
  "version": "0.1.8",
  "publisher": "perun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azagor/perun"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The companion connects to the local Perun service only in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "perun.openDashboard",
        "title": "Perun: Open Dashboard"
      },
      {
        "command": "perun.sendSelection",
        "title": "Perun: Send Selection to OpenCode"
      },
      {
        "command": "perun.resumeTui",
        "title": "Perun: Resume latest TUI chat"
      },
      {
        "command": "perun.openTui",
        "title": "Perun: Choose TUI session\u00e2\u20ac\u00a6"
      },
      {
        "command": "perun.revealLastEdit",
        "title": "Perun: Reveal Last Agent Edit"
      },
      {
        "command": "perun.reconnect",
        "title": "Perun: Reconnect"
      },
      {
        "command": "perun.manageTrust",
        "title": "Perun: Manage Workspace Trust"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "perun.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ]
    },
    "keybindings": [
      {
        "command": "perun.sendSelection",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Perun",
      "properties": {
        "perun.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8760",
          "scope": "application",
          "description": "Perun dashboard endpoint. Loopback only."
        },
        "perun.autoFollowEdits": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show where an OpenCode agent edited: highlight a visible file, or offer a click-to-reveal status hint. Never raises the window."
        },
        "perun.revealMode": {
          "type": "string",
          "enum": [
            "open",
            "reveal",
            "off"
          ],
          "default": "open",
          "scope": "application",
          "description": "Open = show the edited file beside the active editor (focused window only) and highlight it. Reveal = only highlight a file that is already open, otherwise show a clickable status-bar hint. Off = do nothing."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "test": "node --test tests/*.test.js",
    "package": "node esbuild.js --production && node -e \"require('node:fs').mkdirSync('../../installer/vscode',{recursive:true})\" && npx @vscode/vsce package --no-dependencies --out ../../installer/vscode/perun-overseer.vsix"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.0"
  }
}
